generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGEMENT
  OPERATIONS
  MARKETING
  EMBASSY
  MANPOWER
  ACCOUNTS
  MEDICAL_REP
  AGENT
  VIEWER
}

model User {
  id           String    @id @default(uuid())
  employeeCode String?   @unique @map("employee_code")
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  mobile       String?
  role         Role
  departmentId String?   @map("department_id")
  designation  String?
  managerId    String?   @map("manager_id")
  isActive     Boolean   @default(true) @map("status")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])
  manager    User?       @relation("UserManager", fields: [managerId], references: [id])
  reports    User[]      @relation("UserManager")
  auditLogs  AuditLog[]
  agent      Agent?

  assignedCandidates    Candidate[]              @relation("AssignedEmployee")
  statusChanges         CandidateStatusHistory[] @relation("StatusChangedBy")
  passportMovementsFrom PassportMovement[]       @relation("PassportMovementFrom")
  passportMovementsTo   PassportMovement[]       @relation("PassportMovementTo")
  tasksAssigned         Task[]                   @relation("TaskAssignee")
  tasksCreated          Task[]                   @relation("TaskCreator")
  notifications         Notification[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Department {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true) @map("status")

  users User[]
  tasks Task[]

  @@map("departments")
}

model Country {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true) @map("status")

  documentTypes DocumentType[]
  companies     Company[]
  demands       Demand[]

  @@map("countries")
}

model DocumentType {
  id             String  @id @default(uuid())
  name           String
  countryId      String? @map("country_id")
  mandatoryFlag  Boolean @default(false) @map("mandatory_flag")
  expiryRequired Boolean @default(false) @map("expiry_required")
  isActive       Boolean @default(true) @map("status")

  country   Country?            @relation(fields: [countryId], references: [id])
  documents CandidateDocument[]

  @@map("document_types")
}

model Setting {
  id           String   @id @default(uuid())
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  dataType     String   @map("data_type")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model FileRegistry {
  id           String    @id @default(uuid())
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  size         Int
  checksum     String?
  uploadedBy   String    @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  archivedAt   DateTime? @map("archived_at")

  companies          Company[]
  agents             Agent[]
  candidateDocuments CandidateDocument[]
  passportMovements  PassportMovement[]
  contracts          Contract[]
  visas              Visa[]
  mofaRecords        MofaRecord[]
  embassyRecords     EmbassyRecord[]
  medicalRecords     MedicalRecord[]
  policeClearances   PoliceClearance[]
  bmetRecords        BmetRecord[]
  tickets            Ticket[]

  @@map("file_registry")
}

model Company {
  id              String  @id @default(uuid())
  companyCode     String  @unique @map("company_code")
  name            String
  countryId       String  @map("country_id")
  address         String?
  contactPerson   String? @map("contact_person")
  phone           String?
  email           String?
  registrationNo  String? @map("registration_no")
  agreementFileId String? @map("agreement_file_id")
  isActive        Boolean @default(true) @map("status")

  country         Country          @relation(fields: [countryId], references: [id])
  agreementFile   FileRegistry?    @relation(fields: [agreementFileId], references: [id])
  demands         Demand[]
  interviewEvents InterviewEvent[]

  @@index([name])
  @@map("companies")
}

model Agent {
  id              String  @id @default(uuid())
  agentCode       String  @unique @map("agent_code")
  name            String
  organization    String?
  contactPerson   String? @map("contact_person")
  mobile          String?
  email           String?
  address         String?
  commissionTerms String? @map("commission_terms")
  agreementFileId String? @map("agreement_file_id")
  // Links an Agent-role login to their own Agent record, so a future
  // Candidate query can scope "own submitted candidates" per SRS 15
  // ("Agent users must never see another agent's candidates").
  userId          String? @unique @map("user_id")
  isActive        Boolean @default(true) @map("status")

  agreementFile FileRegistry? @relation(fields: [agreementFileId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  candidates    Candidate[]

  @@index([name])
  @@map("agents")
}

enum DemandStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

model Demand {
  id           String       @id @default(uuid())
  demandNo     String       @unique @map("demand_no")
  companyId    String       @map("company_id")
  countryId    String       @map("country_id")
  title        String
  receivedDate DateTime     @map("received_date")
  deadline     DateTime?
  status       DemandStatus @default(OPEN)
  notes        String?

  company         Company          @relation(fields: [companyId], references: [id])
  country         Country          @relation(fields: [countryId], references: [id])
  positions       DemandPosition[]
  candidates      Candidate[]
  interviewEvents InterviewEvent[]
  tasks           Task[]

  @@map("demands")
}

model DemandPosition {
  id            String   @id @default(uuid())
  demandId      String   @map("demand_id")
  position      String
  requiredQty   Int      @map("required_qty")
  salary        Decimal?
  currency      String?
  accommodation String?
  food          String?
  workingHours  String?  @map("working_hours")
  benefits      String?
  isActive      Boolean  @default(true) @map("status")

  demand     Demand      @relation(fields: [demandId], references: [id])
  candidates Candidate[]

  @@map("demand_positions")
}

enum CandidateStatus {
  SOURCED
  REGISTERED
  DOCUMENT_VERIFICATION
  CV_READY
  SHORTLISTED
  INTERVIEW
  SELECTED
  CONTRACT
  VISA_PROCESSING
  VISA_RECEIVED
  MOFA_EMBASSY
  MEDICAL
  POLICE_CLEARANCE
  BMET_MANPOWER
  TICKETING
  READY_TO_DEPART
  DEPARTED
  ON_HOLD
  REJECTED
  CANCELLED
  VISA_REJECTED
  MEDICAL_UNFIT
  PASSPORT_ISSUE
  DOCUMENT_REJECTED
  BMET_REJECTED
  WITHDRAWN
}

model Candidate {
  id                 String          @id @default(uuid())
  candidateCode      String          @unique @map("candidate_code")
  fullName           String          @map("full_name")
  fatherName         String?         @map("father_name")
  dob                DateTime?
  gender             String?
  maritalStatus      String?         @map("marital_status")
  mobile             String?
  altMobile          String?         @map("alt_mobile")
  address            String?
  passportNo         String          @map("passport_no")
  passportIssue      DateTime?       @map("passport_issue")
  passportExpiry     DateTime?       @map("passport_expiry")
  profession         String?
  experienceYears    Int?            @map("experience_years")
  education          String?
  source             String?
  agentId            String?         @map("agent_id")
  demandId           String?         @map("demand_id")
  positionId         String?         @map("position_id")
  assignedEmployeeId String?         @map("assigned_employee_id")
  currentStatus      CandidateStatus @default(REGISTERED) @map("current_status")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  agent             Agent?                   @relation(fields: [agentId], references: [id])
  demand            Demand?                  @relation(fields: [demandId], references: [id])
  position          DemandPosition?          @relation(fields: [positionId], references: [id])
  assignedEmployee  User?                    @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  statusHistory     CandidateStatusHistory[]
  documents         CandidateDocument[]
  passportMovements PassportMovement[]
  interviews        InterviewCandidate[]
  contract          Contract?
  visas             Visa[]
  mofaRecords       MofaRecord[]
  embassyRecords    EmbassyRecord[]
  medicalRecords    MedicalRecord[]
  policeClearances  PoliceClearance[]
  bmetRecords       BmetRecord[]
  ticket            Ticket?
  departure         Departure?
  tasks             Task[]

  @@index([passportNo])
  @@index([currentStatus])
  @@index([agentId])
  @@index([demandId])
  @@map("candidates")
}

model Ticket {
  id                String    @id @default(uuid())
  candidateId       String    @unique @map("candidate_id")
  airline           String?
  pnr               String?
  ticketNo          String?   @map("ticket_no")
  flightNo          String?   @map("flight_no")
  departureDatetime DateTime? @map("departure_datetime")
  origin            String?
  destination       String?
  fileId            String?   @map("file_id")
  status            String    @default("PENDING")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@map("tickets")
}

model Departure {
  id               String    @id @default(uuid())
  candidateId      String    @unique @map("candidate_id")
  departureDate    DateTime? @map("departure_date")
  airport          String?
  destination      String?
  actualDeparture  DateTime? @map("actual_departure")
  deploymentStatus String?   @map("deployment_status")
  remarks          String?

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("departures")
}

model BmetRecord {
  id             String    @id @default(uuid())
  candidateId    String    @map("candidate_id")
  contractStatus String?   @map("contract_status")
  registrationNo String?   @map("registration_no")
  submissionDate DateTime? @map("submission_date")
  clearanceDate  DateTime? @map("clearance_date")
  smartCardNo    String?   @map("smart_card_no")
  status         String    @default("PENDING")
  fileId         String?   @map("file_id")
  isCurrent      Boolean   @default(true) @map("is_current")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@map("bmet_records")
}

enum PoliceClearanceStatus {
  PENDING
  SUBMITTED
  RECEIVED
  REJECTED
  EXPIRED
  NOT_REQUIRED
}

model PoliceClearance {
  id              String                @id @default(uuid())
  candidateId     String                @map("candidate_id")
  applicationDate DateTime?             @map("application_date")
  submissionDate  DateTime?             @map("submission_date")
  issueDate       DateTime?             @map("issue_date")
  expiryDate      DateTime?             @map("expiry_date")
  status          PoliceClearanceStatus @default(PENDING)
  fileId          String?               @map("file_id")
  isCurrent       Boolean               @default(true) @map("is_current")
  remarks         String?
  createdAt       DateTime              @default(now()) @map("created_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@map("police_clearances")
}

enum MedicalStatus {
  PENDING
  APPOINTMENT
  UNDER_PROCESS
  FIT
  UNFIT
  RETEST
}

model MedicalRecord {
  id              String        @id @default(uuid())
  candidateId     String        @map("candidate_id")
  center          String?
  appointmentDate DateTime?     @map("appointment_date")
  examDate        DateTime?     @map("exam_date")
  result          String?
  fitDate         DateTime?     @map("fit_date")
  expiryDate      DateTime?     @map("expiry_date")
  fitCardFileId   String?       @map("fit_card_file_id")
  status          MedicalStatus @default(PENDING)
  isCurrent       Boolean       @default(true) @map("is_current")
  remarks         String?
  createdAt       DateTime      @default(now()) @map("created_at")

  candidate   Candidate     @relation(fields: [candidateId], references: [id])
  fitCardFile FileRegistry? @relation(fields: [fitCardFileId], references: [id])

  @@index([candidateId])
  @@map("medical_records")
}

model Visa {
  id          String    @id @default(uuid())
  candidateId String    @map("candidate_id")
  visaNo      String?   @map("visa_no")
  visaType    String?   @map("visa_type")
  profession  String?
  sponsor     String?
  issueDate   DateTime? @map("issue_date")
  expiryDate  DateTime? @map("expiry_date")
  status      String    @default("PENDING")
  fileId      String?   @map("file_id")
  isCurrent   Boolean   @default(true) @map("is_current")
  remarks     String?
  createdAt   DateTime  @default(now()) @map("created_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@map("visas")
}

model MofaRecord {
  id             String    @id @default(uuid())
  candidateId    String    @map("candidate_id")
  mofaNo         String?   @map("mofa_no")
  submissionDate DateTime? @map("submission_date")
  approvalDate   DateTime? @map("approval_date")
  status         String    @default("PENDING")
  fileId         String?   @map("file_id")
  isCurrent      Boolean   @default(true) @map("is_current")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@map("mofa_records")
}

model EmbassyRecord {
  id              String    @id @default(uuid())
  candidateId     String    @map("candidate_id")
  appointmentDate DateTime? @map("appointment_date")
  submissionDate  DateTime? @map("submission_date")
  collectionDate  DateTime? @map("collection_date")
  status          String    @default("PENDING")
  fileId          String?   @map("file_id")
  isCurrent       Boolean   @default(true) @map("is_current")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@map("embassy_records")
}

model Contract {
  id           String    @id @default(uuid())
  candidateId  String    @unique @map("candidate_id")
  contractNo   String    @unique @map("contract_no")
  contractDate DateTime  @map("contract_date")
  salary       Decimal?
  currency     String?
  duration     String?
  fileId       String?   @map("file_id")
  signedDate   DateTime? @map("signed_date")
  status       String    @default("PENDING")

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  file      FileRegistry? @relation(fields: [fileId], references: [id])

  @@map("contracts")
}

enum InterviewResult {
  SELECTED
  REJECTED
  HOLD
  SECOND_INTERVIEW
  NO_SHOW
}

enum InterviewAttendance {
  PRESENT
  ABSENT
}

model InterviewEvent {
  id          String    @id @default(uuid())
  eventCode   String    @unique @map("event_code")
  companyId   String    @map("company_id")
  demandId    String    @map("demand_id")
  eventDate   DateTime  @map("event_date")
  venue       String?
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  interviewer String?
  capacity    Int?
  status      String    @default("SCHEDULED")

  company    Company              @relation(fields: [companyId], references: [id])
  demand     Demand               @relation(fields: [demandId], references: [id])
  candidates InterviewCandidate[]

  @@map("interview_events")
}

model InterviewCandidate {
  id          String               @id @default(uuid())
  eventId     String               @map("event_id")
  candidateId String               @map("candidate_id")
  serialNo    Int                  @map("serial_no")
  attendance  InterviewAttendance?
  result      InterviewResult?
  score       Decimal?
  remarks     String?

  event     InterviewEvent @relation(fields: [eventId], references: [id])
  candidate Candidate      @relation(fields: [candidateId], references: [id])

  @@unique([eventId, candidateId])
  @@index([eventId])
  @@index([candidateId])
  @@map("interview_candidates")
}

model PassportMovement {
  id                    String    @id @default(uuid())
  candidateId           String    @map("candidate_id")
  fromUserId            String?   @map("from_user_id")
  toUserId              String?   @map("to_user_id")
  fromLocation          String?   @map("from_location")
  toLocation            String?   @map("to_location")
  handedAt              DateTime  @default(now()) @map("handed_at")
  receivedAt            DateTime? @map("received_at")
  purpose               String?
  acknowledgementFileId String?   @map("acknowledgement_file")
  remarks               String?

  candidate           Candidate     @relation(fields: [candidateId], references: [id])
  fromUser            User?         @relation("PassportMovementFrom", fields: [fromUserId], references: [id])
  toUser              User?         @relation("PassportMovementTo", fields: [toUserId], references: [id])
  acknowledgementFile FileRegistry? @relation(fields: [acknowledgementFileId], references: [id])

  @@index([candidateId])
  @@map("passport_movements")
}

enum CandidateDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

model CandidateDocument {
  id             String                  @id @default(uuid())
  candidateId    String                  @map("candidate_id")
  documentTypeId String                  @map("document_type_id")
  fileId         String                  @map("file_id")
  version        Int                     @default(1)
  issueDate      DateTime?               @map("issue_date")
  expiryDate     DateTime?               @map("expiry_date")
  status         CandidateDocumentStatus @default(PENDING)
  uploadedBy     String                  @map("uploaded_by")
  verifiedBy     String?                 @map("verified_by")
  verifiedAt     DateTime?               @map("verified_at")
  remarks        String?
  createdAt      DateTime                @default(now()) @map("created_at")

  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  file         FileRegistry @relation(fields: [fileId], references: [id])

  @@index([candidateId])
  @@index([candidateId, documentTypeId])
  @@map("candidate_documents")
}

model CandidateStatusHistory {
  id          String           @id @default(uuid())
  candidateId String           @map("candidate_id")
  oldStatus   CandidateStatus? @map("old_status")
  newStatus   CandidateStatus  @map("new_status")
  changedBy   String           @map("changed_by")
  changedAt   DateTime         @default(now()) @map("changed_at")
  remarks     String?

  candidate     Candidate @relation(fields: [candidateId], references: [id])
  changedByUser User      @relation("StatusChangedBy", fields: [changedBy], references: [id])

  @@index([candidateId])
  @@map("candidate_status_history")
}

// SRS gives no explicit vocabulary for priority/status (unlike, say,
// PoliceClearanceStatus); these are a judgment call documented in
// docs/BUILD_NOTES.md.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id           String       @id @default(uuid())
  taskNo       String       @unique @map("task_no")
  title        String
  candidateId  String?      @map("candidate_id")
  demandId     String?      @map("demand_id")
  departmentId String?      @map("department_id")
  assignedTo   String?      @map("assigned_to")
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @map("due_date")
  status       TaskStatus   @default(PENDING)
  createdBy    String       @map("created_by")
  completedAt  DateTime?    @map("completed_at")
  remarks      String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  candidate  Candidate?  @relation(fields: [candidateId], references: [id])
  demand     Demand?     @relation(fields: [demandId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  assignee   User?       @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator    User        @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([assignedTo])
  @@index([candidateId])
  @@index([status])
  @@map("tasks")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  title      String
  message    String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
