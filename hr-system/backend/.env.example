# Copy to .env and adjust for your local server.

# PostgreSQL connection string
DATABASE_URL="postgresql://hr_user:hr_password@localhost:5432/rahmania_hr?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ZKTeco K50A device (LAN, SDK protocol, not ADMS/cloud push)
ZKTECO_IP="192.168.1.201"
ZKTECO_PORT=4370
ZKTECO_INPORT=4000
ZKTECO_TIMEOUT_MS=10000

# Directory (relative to backend/) where uploaded documents/photos and
# generated payslip PDFs are stored on the local server disk.
UPLOAD_DIR="uploads"

# Seed admin user (used only by prisma/seed.js on first run)
SEED_ADMIN_EMAIL="admin@rahmania.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
